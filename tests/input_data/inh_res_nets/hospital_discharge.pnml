      <transition id="start">
        <name>
          <text>Register Discharge Request</text>
        </name>
      </transition>
      <transition id="reset">
        <name>
          <text>Resolve All Discrepancies</text>
        </name>
      </transition>
      <transition id="authorize">
        <name>
          <text>Authorize Discharge</text>
        </name>
      </transition>
      <transition id="join">
        <name>
          <text>Assemble Discharge Package</text>
        </name>
      </transition>
      <transition id="issue">
        <name>
          <text>Record Clinical Discrepancy</text>
